Error GDScriptAnalyzer::analyze() {
	parser->errors.clear();

	Error err = resolve_inheritance();
	if (err) {
		return err;
	}

	resolve_interface();
	err = resolve_body();
	if (err) {
		return err;
	}

	return resolve_dependencies();
}

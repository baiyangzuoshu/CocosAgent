	template<class T>
	static void register_type() {
		
		GLOBAL_LOCK_FUNCTION;
		T::initialize_type();
		TypeInfo *t=types.getptr(T::get_type_static());
		ERR_FAIL_COND(!t);
		t->creation_func=&creator<T>;
		T::register_custom_data_to_otdb();
	}

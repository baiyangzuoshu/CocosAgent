{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "CocosAgent command catalog",
  "$defs": {
    "snapshotInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetNodeName": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "nodeInspectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodePath"],
      "properties": { "nodePath": { "type": "string", "minLength": 1, "maxLength": 240 } }
    },
    "importPngInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "pngSpriteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetName", "action"],
      "properties": {
        "assetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.png$" },
        "action": { "enum": ["apply", "compensate", "replay"] },
        "operationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
      }
    },
    "pngSpriteInput2x": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetName", "action"],
      "properties": {
        "assetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.png$" },
        "action": { "enum": ["apply", "compensate", "replay"] },
        "operationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "position": { "$ref": "#/$defs/canvasPosition" }
      }
    },
    "canvasPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "y": { "type": "number", "minimum": -4096, "maximum": 4096 }
      }
    },
    "nodeCreateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentPath", "parentUuid", "nodeName", "action"],
      "properties": {
        "parentPath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "parentUuid": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeName": { "type": "string", "pattern": "^[A-Za-z0-9_ -]{1,64}$" },
        "action": { "enum": ["apply", "compensate", "replay"] },
        "sourceOperationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "operationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
      }
    },
    "nodeCreateInput2x": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentPath", "parentUuid", "nodeName", "action"],
      "properties": {
        "parentPath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "parentUuid": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeName": { "type": "string", "pattern": "^[A-Za-z0-9_ -]{1,64}$" },
        "action": { "enum": ["apply", "compensate", "replay"] },
        "components": { "type": "array", "maxItems": 1, "items": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["classId", "spriteFrameUuid"], "properties": {
            "classId": { "const": "cc.Sprite" }, "spriteFrameUuid": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" } } },
          { "type": "object", "additionalProperties": false, "required": ["classId", "text"], "properties": {
            "classId": { "const": "cc.Label" }, "text": { "type": "string", "maxLength": 256 } } }
        ] } },
        "transform": { "type": "object", "additionalProperties": false, "properties": {
          "position": { "$ref": "#/$defs/canvasPosition" },
          "scale": { "$ref": "#/$defs/canvasPosition" }
        } },
        "sourceOperationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "operationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion", "access", "inputSchema", "input", "preconditions", "status", "reason"],
      "properties": {
        "id": { "enum": ["scene.snapshot", "scene.node.inspect", "asset.importPng", "scene.pngSprite", "scene.node.create"] },
        "contractVersion": { "const": "0.1" },
        "access": { "enum": ["read", "write"] },
        "inputSchema": { "type": "string" },
        "input": { "type": "object" },
        "preconditions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "status": { "enum": ["available", "unavailable"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch-result.schema.json",
  "title": "CocosAgent dispatch result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "outcome", "command", "instance", "operationId", "result", "phases", "intent", "error"],
  "properties": {
    "success": { "type": "boolean" },
    "outcome": { "enum": ["completed", "needs-preview", "needs-review", "failed"] },
    "command": { "type": ["string", "null"] },
    "instance": { "type": ["object", "null"] },
    "operationId": { "type": ["string", "null"] },
    "result": { "type": ["object", "null"] },
    "phases": { "type": ["object", "null"] },
    "intent": { "type": ["string", "null"] },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["code", "message", "phase", "retryable", "sideEffect"],
          "properties": {
            "code": { "type": "string" }, "message": { "type": "string" },
            "phase": { "enum": ["selection", "execution", "record", "preview"] },
            "retryable": { "type": "boolean" },
            "sideEffect": { "enum": ["none", "possible", "confirmed", "unknown"] }
          } }
      ]
    },
    "details": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "success": { "const": true } }, "required": ["success"] },
      "then": { "properties": { "error": { "type": "null" }, "outcome": { "enum": ["completed", "needs-preview"] } } } },
    { "if": { "properties": { "success": { "const": false } }, "required": ["success"] },
      "then": { "properties": { "outcome": { "enum": ["needs-review", "failed"] }, "error": { "type": "object" } } } }
  ]
}

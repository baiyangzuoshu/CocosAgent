{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/content-from-scene-0.1.json",
  "title": "Stage built-in content from a completed Creator 2.4 scene pipeline",
  "oneOf": [
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "content.fromScene.plan" } } },
    { "$ref": "#/$defs/request", "properties": { "method": { "const": "content.fromScene.stage" } } }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["content.fromScene.plan", "content.fromScene.stage"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "projectRoot", "creatorVersion", "pipelineId", "releaseId", "entryAssetName", "assets"],
          "properties": {
            "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "pipelineId": { "type": "string", "format": "uuid" },
            "releaseId": { "type": "string", "pattern": "^(?!(selected|effective)$)[a-z0-9][a-z0-9._-]{0,63}$" },
            "entryAssetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.[pP][nN][gG]$" },
            "assets": {
              "type": "array", "minItems": 1, "maxItems": 16,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["assetName", "id"],
                "properties": {
                  "assetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.[pP][nN][gG]$" },
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                  "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } }
                }
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "enum": ["2.4.15", "3.8.7"] }
      }
    }
  }
}

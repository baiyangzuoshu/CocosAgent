{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/content-preview-0.1.json",
  "title": "Creator 2.4.15 Web-Mobile content preview 0.1",
  "oneOf": [
    { "$ref": "#/$defs/previewRequest", "properties": { "method": { "const": "content.preview.start" } } },
    { "$ref": "#/$defs/previewRequest", "properties": { "method": { "const": "content.preview.get" } } },
    { "$ref": "#/$defs/previewRequest", "properties": { "method": { "const": "content.preview.stop" } } }
  ],
  "$defs": {
    "previewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["content.preview.start", "content.preview.get", "content.preview.stop"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectRoot", "creatorVersion", "buildId"],
          "properties": {
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "buildId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" }
          }
        }
      }
    }
  }
}

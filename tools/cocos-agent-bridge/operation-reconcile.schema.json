{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/operation-reconcile-0.1.json",
  "title": "Operation reconciliation request 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "projectRoot", "creatorVersion", "operationId"],
  "properties": {
    "targets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion"], "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "enum": ["2.4.15", "3.8.7"] }
      } } },
    "projectRoot": { "type": "string", "minLength": 1 },
    "creatorVersion": { "enum": ["2.4.15", "3.8.7"] },
    "operationId": { "type": "string", "format": "uuid" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/asset-scene-pipeline-0.1.json",
  "title": "Creator 2.4 resource-to-scene pipeline 0.1",
  "oneOf": [
    { "$ref": "#/$defs/planOrExecute" },
    { "$ref": "#/$defs/byPipelineId" },
    { "$ref": "#/$defs/previewAccept" },
    { "$ref": "#/$defs/validate" },
    { "$ref": "#/$defs/repair" }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "enum": ["2.4.15", "3.8.7"] }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "y": { "type": "number", "minimum": -4096, "maximum": 4096 }
      }
    },
    "planOrExecute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["assets.scene.plan", "assets.scene.execute"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "projectRoot", "creatorVersion", "sources"],
          "properties": {
            "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "pipelineId": { "type": "string", "format": "uuid" },
            "sources": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "positions": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/position" } }
          }
        }
      }
    },
    "byPipelineId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["assets.scene.get", "assets.scene.compensate"] },
        "params": { "$ref": "#/$defs/pipelineTarget" }
      }
    },
    "previewAccept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "const": "assets.scene.preview.accept" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectRoot", "creatorVersion", "pipelineId", "operationId", "evidence"],
          "properties": {
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "pipelineId": { "type": "string", "format": "uuid" },
            "operationId": { "type": "string", "format": "uuid" },
            "evidence": { "type": "object", "additionalProperties": false,
              "required": ["url", "observedAt", "note"], "properties": {
                "url": { "type": "string", "format": "uri" },
                "observedAt": { "type": "string", "format": "date-time" },
                "note": { "type": "string", "minLength": 1, "maxLength": 500 }
              } }
          }
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "const": "assets.scene.validate" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "projectRoot", "creatorVersion", "pipelineId"],
          "properties": {
            "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "pipelineId": { "type": "string", "format": "uuid" },
            "assetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.png$" }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "const": "assets.scene.repair" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "projectRoot", "creatorVersion", "pipelineId", "assetName"],
          "properties": {
            "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "pipelineId": { "type": "string", "format": "uuid" },
            "assetName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.png$" },
            "repairId": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    "pipelineTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion", "pipelineId"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "const": "2.4.15" },
        "pipelineId": { "type": "string", "format": "uuid" }
      }
    }
  }
}

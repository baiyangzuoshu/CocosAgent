{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-create-operation.schema.json",
  "title": "CocosAgent scene.node.create persisted operation 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "capabilityId", "operationId", "projectRoot", "creatorVersion", "manifest", "sceneName", "createdNodeUuid", "intent", "receipts", "phases", "createdAt", "updatedAt"],
  "properties": {
    "contractVersion": { "const": "0.1" },
    "capabilityId": { "const": "scene.node.create" },
    "operationId": { "type": "string", "format": "uuid" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "creatorVersion": { "enum": ["2.4.15", "3.8.7"] },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["parentPath", "parentUuid", "nodeName", "action", "sourceOperationId", "targetNodeUuid", "components", "transform"],
      "properties": {
        "parentPath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "parentUuid": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeName": { "type": "string", "pattern": "^[A-Za-z0-9_ -]{1,64}$" },
        "action": { "enum": ["apply", "compensate", "replay"] },
        "sourceOperationId": { "type": ["string", "null"] },
        "targetNodeUuid": { "type": ["string", "null"] },
        "components": { "type": "array", "maxItems": 1, "items": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["classId", "spriteFrameUuid"], "properties": {
            "classId": { "const": "cc.Sprite" }, "spriteFrameUuid": { "type": "string", "format": "uuid" } } },
          { "type": "object", "additionalProperties": false, "required": ["classId", "text"], "properties": {
            "classId": { "const": "cc.Label" }, "text": { "type": "string", "maxLength": 256 } } }
        ] } },
        "transform": { "type": "object", "additionalProperties": false, "properties": {
          "position": { "$ref": "#/$defs/vector2" }, "scale": { "$ref": "#/$defs/vector2" }
        } }
      }
    },
    "sceneName": { "type": ["string", "null"] },
    "createdNodeUuid": { "type": ["string", "null"] },
    "intent": { "enum": ["created", "editor-write-sent", "disk-verified", "disk-recovered"] },
    "previewAttempt": { "type": "object", "additionalProperties": false, "required": ["status", "attemptedAt", "error"],
      "properties": {
        "status": { "const": "failed" },
        "attemptedAt": { "type": "string", "format": "date-time" },
        "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 64 }, "message": { "type": "string", "minLength": 1, "maxLength": 500 } } }
      }
    },
    "reconciliation": { "type": "object", "additionalProperties": false,
      "required": ["disposition", "observedAt", "sceneName", "parentPath", "parentUuid", "targetPath", "diskPath", "diskSha256"],
      "properties": {
        "disposition": { "const": "no-effect" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sceneName": { "type": "string", "maxLength": 64 },
        "parentPath": { "type": "string", "maxLength": 240 },
        "parentUuid": { "type": "string", "maxLength": 64 },
        "targetPath": { "type": "string", "maxLength": 240 },
        "diskPath": { "type": "string", "maxLength": 512 },
        "diskSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "receipts": { "type": "array", "items": { "type": "object" } },
    "phases": { "type": "object", "additionalProperties": false,
      "required": ["capability", "preflight", "editor", "disk", "preview", "recovery"],
      "properties": {
        "capability": { "$ref": "#/$defs/phaseStatus" },
        "preflight": { "$ref": "#/$defs/phaseStatus" },
        "editor": { "$ref": "#/$defs/phaseStatus" },
        "disk": { "$ref": "#/$defs/phaseStatus" },
        "preview": { "$ref": "#/$defs/phaseStatus" },
        "recovery": { "$ref": "#/$defs/phaseStatus" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "phaseStatus": { "enum": ["pending", "passed", "failed", "skipped"] },
    "vector2": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
      "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
      "y": { "type": "number", "minimum": -4096, "maximum": 4096 }
    } }
  }
}

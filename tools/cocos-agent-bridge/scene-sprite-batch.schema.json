{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/scene-sprite-batch-0.1.json",
  "title": "Creator 2.4 scene Sprite batch 0.1",
  "oneOf": [
    { "$ref": "#/$defs/planOrExecute" },
    { "$ref": "#/$defs/getOrCompensate" },
    { "$ref": "#/$defs/replay" }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "enum": ["2.4.15", "3.8.7"] }
      }
    },
    "planOrExecute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "projectRoot", "creatorVersion", "assets"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "const": "2.4.15" },
        "batchId": { "type": "string", "format": "uuid" },
        "assets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,94}\\.png$" }
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
              "y": { "type": "number", "minimum": -4096, "maximum": 4096 }
            }
          },
          "description": "Optional Canvas-local design-pixel positions paired by index with assets. Length must equal assets."
        }
      }
    },
    "getOrCompensate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion", "batchId"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "const": "2.4.15" },
        "batchId": { "type": "string", "format": "uuid" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "creatorVersion", "sourceBatchId"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "creatorVersion": { "const": "2.4.15" },
        "sourceBatchId": { "type": "string", "format": "uuid" }
      }
    }
  }
}

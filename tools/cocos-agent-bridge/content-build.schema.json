{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/content-build-0.1.json",
  "title": "Creator 2.4.15 Web-Mobile content build 0.1",
  "oneOf": [
    { "$ref": "#/$defs/buildRequest", "properties": { "method": { "const": "content.build.plan" } } },
    { "$ref": "#/$defs/buildRequest", "properties": { "method": { "const": "content.build.execute" } } },
    { "$ref": "#/$defs/getRequest", "properties": { "method": { "const": "content.build.get" } } },
    { "$ref": "#/$defs/getRequest", "properties": { "method": { "const": "content.build.reconcile" } } }
  ],
  "$defs": {
    "buildRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["content.build.plan", "content.build.execute"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectRoot", "creatorVersion", "releaseId", "expectedFingerprint", "buildId"],
          "properties": {
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "releaseId": { "type": "string", "pattern": "^(?!(selected|effective)$)[a-z0-9][a-z0-9._-]{0,63}$" },
            "expectedFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "buildId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" }
          }
        }
      }
    },
    "getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "enum": ["content.build.get", "content.build.reconcile"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectRoot", "creatorVersion", "buildId"],
          "properties": {
            "projectRoot": { "type": "string", "minLength": 1 },
            "creatorVersion": { "const": "2.4.15" },
            "buildId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" }
          }
        }
      }
    }
  }
}

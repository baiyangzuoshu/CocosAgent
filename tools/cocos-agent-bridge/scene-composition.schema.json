{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocos-agent.local/schema/scene-composition-0.1.json",
  "title": "Scene composition request 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "projectRoot", "creatorVersion", "steps"],
  "properties": {
    "targets": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["projectRoot", "creatorVersion"], "properties": { "projectRoot": { "type": "string" }, "creatorVersion": { "enum": ["2.4.15", "3.8.7"] } } } },
    "projectRoot": { "type": "string" },
    "creatorVersion": { "enum": ["2.4.15", "3.8.7"] },
    "workflowId": { "type": "string", "format": "uuid" },
    "steps": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "parent"], "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "name": { "type": "string", "pattern": "^[A-Za-z0-9_ -]{1,64}$" },
      "components": { "type": "array", "maxItems": 1, "items": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["classId", "spriteFrameUuid"], "properties": {
          "classId": { "const": "cc.Sprite" }, "spriteFrameUuid": { "type": "string", "format": "uuid" } } },
        { "type": "object", "additionalProperties": false, "required": ["classId", "text"], "properties": {
          "classId": { "const": "cc.Label" }, "text": { "type": "string", "maxLength": 256 } } }
      ] } },
      "transform": { "type": "object", "additionalProperties": false, "properties": {
        "position": { "$ref": "#/$defs/vector2" }, "scale": { "$ref": "#/$defs/vector2" }
      } },
      "parent": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["path", "uuid"], "properties": { "path": { "type": "string" }, "uuid": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["ref"], "properties": { "ref": { "type": "string" } } }
      ] }
    } } }
  },
  "allOf": [
    {
      "if": { "properties": { "creatorVersion": { "const": "3.8.7" } }, "required": ["creatorVersion"] },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["components"] },
                  { "required": ["transform"] }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": { "vector2": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
    "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
    "y": { "type": "number", "minimum": -4096, "maximum": 4096 }
  } } }
}
